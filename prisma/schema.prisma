// SIDCUL Manufacturers Association — Hyper-Local Job Portal
// MongoDB data model for the MVP: companies post jobs, students apply.
// Roles, job types and statuses are stored as strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// A single account. `role` is one of: STUDENT | COMPANY | ADMIN
model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT")
  name         String
  createdAt    DateTime @default(now())

  companyProfile CompanyProfile?
  studentProfile StudentProfile?
  applications   Application[]
}

/// Extra data for COMPANY accounts. Must be `verified` by an admin before posting.
model CompanyProfile {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  about       String?
  location    String?
  website     String?
  whatsappNumber String? // public WhatsApp contact, e.g. +91 87555 00021
  contactEmail   String? // public contact email (distinct from the login email on User)
  mapUrl         String? // Google Maps share link / place URL for the company's location
  sector      String? // one of SECTORS, or a free-text value when "Others" was chosen
  phone       String? // Indian mobile, e.g. +91 98765 43210
  gstNumber   String? // 15-char GSTIN
  emDocumentUrl String? // Entrepreneurs Memorandum / Udyam registration doc, uploaded to Cloudinary
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Public-directory media, uploaded from the company dashboard. Only shown
  // on the public directory page when this profile is linked to one below.
  logoUrl        String?
  galleryImage1Url String?
  galleryImage2Url String?

  // Optional 1:1 link to a public DirectoryCompany listing — lets a real
  // company account (verified via signup/admin) own and enrich a directory
  // page with a logo + gallery, without touching the scraped directory data.
  // Not marked @unique: MongoDB's unique index rejects multiple `null`s,
  // which every unlinked profile would have. Uniqueness (at most one
  // CompanyProfile per DirectoryCompany) is enforced in application code.
  directoryCompanyId String?           @db.ObjectId
  directoryCompany    DirectoryCompany? @relation(fields: [directoryCompanyId], references: [id])

  jobs Job[]
  equipment     Equipment[]    @relation("EquipmentOwner")
  leaseRequests LeaseRequest[] @relation("LeaseRequester")
}

/// Extra data for STUDENT accounts.
model StudentProfile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String?
  education String?
  skills    String?
  createdAt DateTime @default(now())
}

/// A job posting owned by a (verified) company.
model Job {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String         @db.ObjectId
  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String
  location    String
  jobType     String         @default("FULL_TIME") // FULL_TIME | PART_TIME | SHIFT | SEASONAL | INTERNSHIP
  sector      String?
  salary      String?
  status      String         @default("OPEN") // OPEN | CLOSED
  createdAt   DateTime       @default(now())

  applications Application[]
}

/// A student's application to a job. One application per student per job.
model Application {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  jobId       String   @db.ObjectId
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId String   @db.ObjectId
  applicant   User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  coverNote   String?
  resume      Resume?
  status      String   @default("APPLIED") // APPLIED | REVIEWED | SHORTLISTED | REJECTED
  createdAt   DateTime @default(now())

  @@unique([jobId, applicantId])
}

/// An uploaded résumé file, stored as binary data in MongoDB. One per Application.
/// The FK lives here (always non-null) so MongoDB's unique index never sees null dups.
model Resume {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  applicationId String      @unique @db.ObjectId
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  data          Bytes
  filename      String
  mimeType      String
  size          Int
  createdAt     DateTime    @default(now())
}

/// A piece of machinery/equipment a (verified) company lists for lease.
model Equipment {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String         @db.ObjectId
  company     CompanyProfile @relation("EquipmentOwner", fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String
  category    String? // one of EQUIPMENT_CATEGORIES
  location    String
  rate        String? // free-text, e.g. "₹5,000/day" — no payment processing
  status      String         @default("LISTED") // LISTED | UNLISTED
  createdAt   DateTime       @default(now())

  leaseRequests LeaseRequest[]
}

/// A managed booking request from one verified company to lease another's equipment.
model LeaseRequest {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  equipmentId String         @db.ObjectId
  equipment   Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  requesterId String         @db.ObjectId
  requester   CompanyProfile @relation("LeaseRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  message     String?
  status      String         @default("PENDING") // PENDING | ACCEPTED | REJECTED | CANCELLED
  createdAt   DateTime       @default(now())
}

/// A read-only directory listing scraped from a public business directory.
/// Represents an IT/tech company located in the SIDCUL IT Park, Dehradun.
model DirectoryCompany {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  category    String?
  address     String?
  area        String?
  pincode     String?
  phone       String?
  email       String?
  website     String?
  description String?
  sourceUrl   String   @unique
  createdAt   DateTime @default(now())

  // Present only for the handful of listings owned by a real registered
  // CompanyProfile (see the relation field there). Modeled as one-to-many
  // on the Prisma side (Mongo can't enforce a unique FK that's also
  // nullable), but application code only ever links at most one.
  companyProfiles CompanyProfile[]
}
